# --- App (local default) ---
APP_ENV=local
APP_NAME=memory-rag-be
API_PREFIX=/api
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Docker Compose MySQL) ---
# Use the same DB_PASSWORD as MYSQL_PASSWORD in infra/docker/.env
DB_HOST=localhost
DB_PORT=3306
DB_USER=memory_rag
DB_PASSWORD=your_local_db_password
DB_NAME=memory_rag
DATABASE_URL=mysql+pymysql://memory_rag:your_local_db_password@localhost:3306/memory_rag

# --- LLM: mock | gemini_api | vertex | openai ---
LLM_PROVIDER=mock
# First real LLM PoC (pip install google-genai from requirements-optional.txt):
# LLM_PROVIDER=gemini_api
# GEMINI_API_KEY=your_api_key_here
# GEMINI_MODEL=gemini-flash-latest
# GCP production path (Phase 4 — pip install -r requirements-optional.txt + GCP auth):
# LLM_PROVIDER=vertex
# VERTEX_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
# --- Vector: none (SQL fallback) | chroma (optional) | vertex (GCP prod skeleton) ---
VECTOR_STORE_PROVIDER=none

# --- Coach workflow ---
ACTIVE_PROMPT_VERSION=v0.3
RECENT_SWING_LIMIT=5
RECENT_MESSAGE_LIMIT=20
ENABLE_MEMORY_UPDATE=true
ENABLE_GUARDRAIL=true

# --- Logging ---
ENABLE_CLOUD_LOGGING=false
LOG_TO_FILE=true
LOG_DIR=logs
LOG_JSON=false

# --- LangSmith / LangGraph Studio tracing (off by default; do not commit real API keys) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=memory-rag-demo
# Regional API endpoints: US https://api.smith.langchain.com
# EU https://eu.api.smith.langchain.com | APAC https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# LANGCHAIN_* mirrors are set by configure_langsmith() when tracing is on.
# Do NOT leave empty LANGCHAIN_TRACING_V2= here — it breaks `langgraph dev`.

# --- Optional: OpenAI (only if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Optional: Vertex AI Gemini (only if LLM_PROVIDER=vertex) ---
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL_NAME=gemini-1.5-flash

# --- Optional: Vertex AI Vector Search (only if VECTOR_STORE_PROVIDER=vertex) ---
VERTEX_VECTOR_INDEX_ID=
VERTEX_VECTOR_ENDPOINT_ID=
VERTEX_VECTOR_DEPLOYED_INDEX_ID=

# --- Optional: GCS (only for cloud video storage) ---
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional: Chroma persist directory (only if VECTOR_STORE_PROVIDER=chroma) ---
CHROMA_PERSIST_DIR=.chroma_memory_rag
