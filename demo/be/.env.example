# --- App (local default) ---
APP_ENV=local
APP_NAME=MemoryRAG-be
API_PREFIX=/api
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Docker Compose MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=memoryrag
DB_PASSWORD=memoryrag
DB_NAME=memoryrag
DATABASE_URL=mysql+pymysql://memoryrag:memoryrag@localhost:3306/memoryrag

# --- LLM: mock (no API keys) | vertex | openai ---
LLM_PROVIDER=mock
# Real LLM demo (after pip install -r requirements-optional.txt + GCP auth):
# LLM_PROVIDER=vertex
# VERTEX_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key

# --- Vector: none (SQL fallback) | chroma (optional) | vertex (GCP prod skeleton) ---
VECTOR_STORE_PROVIDER=none

# --- Coach workflow ---
ACTIVE_PROMPT_VERSION=v0.3
RECENT_SWING_LIMIT=5
RECENT_MESSAGE_LIMIT=20
ENABLE_MEMORY_UPDATE=true
ENABLE_GUARDRAIL=true

# --- Logging ---
ENABLE_CLOUD_LOGGING=false
LOG_TO_FILE=true
LOG_DIR=logs
LOG_JSON=false

# --- Optional: LangSmith tracing (off by default; do not commit real API keys) ---
# Set LANGSMITH_TRACING=true and LANGSMITH_API_KEY only when using LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MemoryRAG-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Compatibility aliases (optional; LANGSMITH_* preferred)
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# --- Optional: OpenAI (only if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Optional: Vertex AI Gemini (only if LLM_PROVIDER=vertex) ---
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL_NAME=gemini-1.5-flash

# --- Optional: Vertex AI Vector Search (only if VECTOR_STORE_PROVIDER=vertex) ---
VERTEX_VECTOR_INDEX_ID=
VERTEX_VECTOR_ENDPOINT_ID=
VERTEX_VECTOR_DEPLOYED_INDEX_ID=

# --- Optional: GCS (only for cloud video storage) ---
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional: Chroma persist directory (only if VECTOR_STORE_PROVIDER=chroma) ---
CHROMA_PERSIST_DIR=.chroma_memoryrag
